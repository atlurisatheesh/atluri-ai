# Frontend environment variables
# Copy to .env.local and fill in values

# Backend API URL (set after deploying backend)
NEXT_PUBLIC_API_URL=http://localhost:9010

# Backend origin used by the live interview + overlay views (Vercel can't proxy
# WebSockets, so these talk to the backend directly). Single source of truth —
# see lib/backend.ts. In production set this to your backend's public https URL.
NEXT_PUBLIC_BACKEND_ORIGIN=http://localhost:9010

# WebSocket URL (defaults to NEXT_PUBLIC_BACKEND_ORIGIN with ws/wss scheme)
NEXT_PUBLIC_WS_URL=ws://localhost:9010

# Public site origin (this frontend deployment)
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3001

# Supabase (optional — app works without it using local auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E2E testing bypass (set to "true" to skip auth)
NEXT_PUBLIC_E2E_BYPASS_AUTH=false
